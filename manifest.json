{
  "manifest_version": 3,
  "name": "Transcripts for CodeTantra Lectures",
  "version": "0.4.4",
  "description": "Study packs from CodeTantra lectures: transcript, notes, MCQs, flashcards.",
  "permissions": ["storage", "scripting", "downloads", "sidePanel"],
  "host_permissions": [
    "https://*.codetantra.com/*",
    "https://codetantra.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Open study pack"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.codetantra.com/*",
        "https://codetantra.com/*"
      ],
      "js": ["config.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
